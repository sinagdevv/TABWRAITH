{
  "manifest_version": 3,
  "name": "TABWRAITH: Curse of the Open Tabs",
  "version": "5.2.0",
  "description": "Dark fantasy pixel RPG. Banish cursed browser tabs with a webcam finger-gun, mouse or Space. Tabs are bookmarked before closing in LIVE MODE.",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage"
  ],
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Launch TABWRAITH",
    "default_icon": {
      "32": "icon-32.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
